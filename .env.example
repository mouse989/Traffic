# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_32_char_hex_string

# JWT Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000

# Database path (default: traffic.db in working directory)
# Set this to a PERSISTENT path so data survives redeployments.
#
# Option A — set the full file path directly:
#   DB_PATH=/data/traffic.db          (Docker named volume or host mount)
#   DB_PATH=/var/data/traffic.db      (Vibe hosting persistent directory)
#
# Option B — set only the directory (app appends /traffic.db):
#   DATA_DIR=/var/data
#   VIBE_DATA_DIR=/persistent
#
# Priority: DB_PATH > DATA_DIR / VIBE_DATA_DIR > default (cwd/traffic.db)
