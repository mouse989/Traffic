# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_32_char_hex_string

# JWT Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────
#
# Option A: PostgreSQL (Vibe hosting / production — data never lost on redeploy)
#   DATABASE_URL=postgresql://traffic_user:your_password@pg-host.vibe.matbao.net:5432/traffic
#
# Option B: SQLite file path (local dev or binary deploy)
#   DB_PATH=/data/traffic.db          (Docker named volume)
#   DB_PATH=/var/data/traffic.db      (host persistent directory)
#
# DATABASE_URL takes priority over DB_PATH when both are set.
