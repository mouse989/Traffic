# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_32_char_hex_string

# JWT Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────
#
# Option A: MySQL (Vibe hosting — dùng host NỘI BỘ khi app chạy trên Vibe)
#   DATABASE_URL=mysql://username:password@ts-db-xxx-mysql-xxxxx:3306/dbname
#
# Option B: PostgreSQL (Vibe hosting)
#   DATABASE_URL=postgresql://username:password@pg-host:5432/dbname
#
# Option C: SQLite file path (local dev or binary deploy)
#   DB_PATH=/data/traffic.db
#
# DATABASE_URL takes priority over DB_PATH when both are set.
DATABASE_URL=mysql://user_65d2cbbb8fa6:CHANGE_ME@ts-db-637-mysql-30027:3306/qrcode_db
